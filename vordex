local ROW_HEIGHT   = 22
local LIST_HEIGHT  = 500
local rootRows     = {}
local rowData      = {}
local scrollOffset = 0

local function updateText(row)
    local d = rowData[row]
    row.Text = string.rep("  ", d.Depth) .. d.Arrow .. " " .. d.Label
end

local refresh

local function scrollBy(delta)
    scrollOffset = math.max(0, scrollOffset + delta)
    refresh()
end

tryConnect(scrollUp, "MouseButton1Click", function() scrollBy(-ROW_HEIGHT * 5) end)
tryConnect(scrollDown, "MouseButton1Click", function() scrollBy(ROW_HEIGHT * 5) end)

if UIS then
    local function handleWheel(input)
        local ut = safeGet(input, "UserInputType")
        if ut ~= Enum.UserInputType.MouseWheel then return end
        local p = safeGet(input, "Position")
        local z = p and (safeGet(p, "Z") or safeGet(p, "z")) or 0
        if type(z) == "number" and z ~= 0 then
            scrollBy(-z * ROW_HEIGHT * 5)
        end
    end
    tryConnect(UIS, "InputChanged", handleWheel)
    tryConnect(UIS, "InputBegan", handleWheel)
end

local function collapseDescendants(row)
    for _, child in ipairs(rowData[row].ChildRows) do
        local cd    = rowData[child]
        cd.Expanded = false
        cd.Arrow    = ">"
        updateText(child)
        collapseDescendants(child)
    end
end

local function makeRow(inst, depth)
    local d = {
        Instance      = inst,
        Depth         = depth,
        ChildRows     = {},
        Expanded      = false,
        Built         = false,
        Arrow         = " ",
        Label         = "[" .. safeClass(inst) .. "] " .. safeName(inst),
        ChildrenCache = {},
    }
    if inst == game then d.Label = "game" end

    d.ChildrenCache = getChildren(inst)
    if #d.ChildrenCache > 0 then d.Arrow = ">" end

    local btn = Instance.new("TextButton")
    btn.Name               = "Row"
    btn.Size               = UDim2.new(1, 0, 0, ROW_HEIGHT)
    btn.Position           = UDim2.new(0, 0, 0, 0)
    btn.BackgroundColor3   = Color3.fromRGB(45, 45, 55)
    setProp(btn, "BackgroundTransparency", 0.35)
    btn.TextColor3         = Color3.fromRGB(225, 225, 225)
    btn.TextSize           = 14
    btn.TextXAlignment     = Enum.TextXAlignment.Left
    btn.Font               = Enum.Font.Figtree
    btn.Text               = ""
    btn.Parent             = listFrame

    rowData[btn] = d
    updateText(btn)

    tryConnect(btn, "MouseButton1Click", function()
        if #d.ChildrenCache == 0 then return end
        if not d.Built then
            d.Built = true
            for _, child in ipairs(d.ChildrenCache) do
                d.ChildRows[#d.ChildRows + 1] = makeRow(child, depth + 1)
            end
        end
        d.Expanded = not d.Expanded
        if d.Expanded then
            d.Arrow = "v"
        else
            d.Arrow = ">"
            collapseDescendants(btn)
        end
        updateText(btn)
        refresh()
    end)

    return btn
end

refresh = function()
    local totalY = 0
    local function measure(row, vis)
        local d = rowData[row]
        if vis then totalY = totalY + ROW_HEIGHT end
        for _, c in ipairs(d.ChildRows) do measure(c, vis and d.Expanded) end
    end
    for _, r in ipairs(rootRows) do measure(r, true) end

    local maxOff = math.max(0, totalY - LIST_HEIGHT)
    if scrollOffset > maxOff then scrollOffset = maxOff end

    local y = 0
    local function place(row, vis)
        local d = rowData[row]
        row.Visible = vis
        if vis then
            local yOff = usingScrolling and y or (y - scrollOffset)
            row.Position = UDim2.new(0, 0, 0, yOff)
            y = y + ROW_HEIGHT
        end
        for _, c in ipairs(d.ChildRows) do place(c, vis and d.Expanded) end
    end
    for _, r in ipairs(rootRows) do place(r, true) end

    if usingScrolling then
        setProp(listFrame, "CanvasSize", UDim2.new(0, 0, 0, totalY))
        setProp(listFrame, "CanvasPosition", Vector2.new(0, scrollOffset))
    end
end

local gameRow = makeRow(game, 0)
rootRows[#rootRows + 1] = gameRow

do
    local d = rowData[gameRow]
    if #d.ChildrenCache > 0 then
        d.Built = true
        for _, child in ipairs(d.ChildrenCache) do
            d.ChildRows[#d.ChildRows + 1] = makeRow(child, 1)
        end
        d.Expanded = true
        d.Arrow    = "v"
        updateText(gameRow)
    end
end

refresh()
