local function safeGet(obj, k)
    if obj == nil then return nil end
    local v
    local ok = pcall(function() v = obj[k] end)
    if ok then return v end
    return nil
end

local function tryConnect(obj, key, fn)
    local sig = safeGet(obj, key)
    if sig == nil then return false end
    local ok = pcall(function() sig:Connect(fn) end)
    return ok
end

local function safeName(inst)
    local ok, n = pcall(function() return inst.Name end)
    return (ok and n) or "?"
end

local function safeClass(inst)
    local ok, c = pcall(function() return inst.ClassName end)
    return (ok and c) or "Instance"
end

local function setProp(obj, k, v)
    pcall(function() obj[k] = v end)
end

local function getXY(a, b)
    if type(a) == "number" and type(b) == "number" then return a, b end
    if a and type(a) ~= "number" then
        local p = safeGet(a, "Position")
        if p then
            local x = safeGet(p, "X") or safeGet(p, "x")
            local y = safeGet(p, "Y") or safeGet(p, "y")
            if type(x) == "number" and type(y) == "number" then return x, y end
        end
    end
    return nil, nil
end

