local function readFramePos()
    local xs, xo, ys, yo = 0.5, -250, 0.5, -300
    local p = safeGet(mainFrame, "Position")
    if p then
        pcall(function() xs = p.X.Scale end)
        pcall(function() xo = p.X.Offset end)
        pcall(function() ys = p.Y.Scale end)
        pcall(function() yo = p.Y.Offset end)
    end
    return { xs = xs, xo = xo, ys = ys, yo = yo }
end

local dragStart = nil

local function beginDrag(x, y)
    if type(x) ~= "number" or type(y) ~= "number" then return end
    dragStart = { x = x, y = y, frame = readFramePos() }
end

local function moveDrag(x, y)
    if not dragStart then return end
    if type(x) ~= "number" or type(y) ~= "number" then return end
    local dx = x - dragStart.x
    local dy = y - dragStart.y
    mainFrame.Position = UDim2.new(
        dragStart.frame.xs, dragStart.frame.xo + dx,
        dragStart.frame.ys, dragStart.frame.yo + dy
    )
end

local function endDrag()
    dragStart = nil
end

tryConnect(titleBar, "MouseButton1Down", function(a, b)
    local x, y = getXY(a, b)
    beginDrag(x, y)
end)

tryConnect(titleBar, "MouseButton1Up", endDrag)
tryConnect(mainFrame, "MouseButton1Up", endDrag)

tryConnect(mainFrame, "MouseMoved", function(a, b)
    if not dragStart then return end
    local x, y = getXY(a, b)
    moveDrag(x, y)
end)

tryConnect(titleBar, "MouseMoved", function(a, b)
