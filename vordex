end)

if UIS then
    tryConnect(UIS, "InputChanged", function(input)
        if not dragStart then return end
        local x, y = getXY(input, nil)
        moveDrag(x, y)
    end)

    tryConnect(UIS, "InputEnded", function(input)
        local ut = safeGet(input, "UserInputType")
        if ut == Enum.UserInputType.MouseButton1 then endDrag() end
    end)
end

