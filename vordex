local function getChildren(inst)
    local r
    local ok = pcall(function() r = inst:GetChildren() end)
    if ok and type(r) == "table" and #r > 0 then return r end
    local out, seen = {}, {}
    for i = 1, #KNOWN_SERVICES do
        local nm = KNOWN_SERVICES[i]
        local ok2, svc = pcall(function() return inst:GetService(nm) end)
        if ok2 and svc ~= nil and not seen[svc] then
            seen[svc] = true
            out[#out + 1] = svc
        end
    end
    if #out > 0 then
        table.sort(out, function(a, b) return safeName(a) < safeName(b) end)
        return out
    end
    return (ok and type(r) == "table") and r or {}
end

